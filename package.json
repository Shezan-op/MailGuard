{
  "name": "mailguard",
  "version": "1.0.0",
  "private": true,
  "description": "Private, Self-Hosted Email Verification & Deliverability Intelligence Engine",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/copy-standalone-assets.js",
    "start": "node .next/standalone/server.js",
    "worker": "tsx workers/verification-worker.ts",
    "maintenance": "tsx workers/maintenance-worker.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:seed": "tsx server/db/seed.ts",
    "db:reset": "tsx server/db/reset.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "doctor": "tsx scripts/doctor.ts",
    "system:verify": "tsx scripts/system-verify.ts",
    "test:disaster-recovery": "tsx scripts/db-backup-restore-test.ts",
    "auth:hash": "tsx scripts/generate-hash.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.16",
    "@tanstack/react-table": "^8.21.2",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.40.0",
    "lucide-react": "^1.16.0",
    "next": "^15.2.1",
    "papaparse": "^5.5.2",
    "pg": "^8.13.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "tailwind-merge": "^3.0.2",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.13.10",
    "@types/papaparse": "^5.3.15",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.30.5",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.2.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
