# ==============================================================================
# MAILGUARD ENVIRONMENT CONFIGURATION
# Private, Self-Hosted Email Verification & Deliverability Intelligence Engine
# ==============================================================================

# Application Environment
NODE_ENV=production
APP_URL=http://localhost:3000

# Database Connection
# If left empty, MailGuard will run in embedded PGlite mode for local zero-config testing.
# For production Docker/VPS deployment, provide a full PostgreSQL connection URL:
DATABASE_URL=postgresql://mailguard:mailguard_secret_password@postgres:5432/mailguard

# Single-Admin Security & Session Secrets
# SESSION_SECRET must be at least 32 random characters
SESSION_SECRET=change-this-to-a-very-long-random-string-at-least-32-chars

# Admin Authentication (Mandatory in production - no default credentials permitted)
# Generate your salted password hash using: npm run auth:hash <your-password>
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD_HASH=generate_with_npm_run_auth_hash

# SMTP Protocol Identity (Used during HELO/EHLO and MAIL FROM protocol negotiation)
# IMPORTANT: Use a domain and hostname you control with valid forward/reverse DNS.
HELO_DOMAIN=mailguard.local
VERIFICATION_FROM_ADDRESS=verify@mailguard.local

# Network & Protocol Timeouts (in milliseconds)
SMTP_TIMEOUT_MS=10000
DNS_TIMEOUT_MS=5000

# Concurrency & Rate Limiting Controls
MAX_GLOBAL_CONCURRENCY=10
MAX_DOMAIN_CONCURRENCY=2

# Retry & Greylisting Strategy
MAX_RETRIES=3
RETRY_DELAY_MS=5000
RETRY_BACKOFF_MULTIPLIER=2

# Verification Cache TTL (in hours)
CACHE_TTL_HOURS=24
DOMAIN_CACHE_TTL_HOURS=24

# Safety Safeguards
# Conservative mode adds extra pacing and reduces concurrency to avoid IP throttling
CONSERVATIVE_MODE=true

# SSRF Protection: NEVER enable in production. Only set to true for local testing with fake SMTP.
ALLOW_PRIVATE_IPS=false
